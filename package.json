{
  "name": "obsidian-mathfolio",
  "version": "0.1.4",
  "private": true,
  "description": "Mathfolio worksheet editor integration for Obsidian.",
  "type": "module",
  "main": "main.js",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Glaysia/obsidian-mathfolio.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "npm run sdk:verify && node scripts/check.mjs && node --check scripts/build.mjs && node --check scripts/sdk-link.mjs && node --check scripts/version.mjs && node --check scripts/install.mjs && node --check scripts/sdk-build.mjs",
    "build": "npm run check && node scripts/build.mjs",
    "check:release": "node scripts/check.mjs --release",
    "sdk:link": "node scripts/sdk-link.mjs",
    "version": "node scripts/version.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:vault": "node scripts/install.mjs",
    "sdk:build": "node scripts/sdk-build.mjs",
    "lint": "eslint . --max-warnings 0",
    "sdk:verify": "node scripts/sdk-verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@eslint/json": "0.14.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.6.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@mathfolio/wasm-sdk": "https://github.com/Glaysia/mathfolio/releases/download/v0.1.1/mathfolio-wasm-sdk-0.1.1.tar.gz"
  },
  "overrides": {
    "obsidian": "$obsidian",
    "moment": "2.31.0"
  }
}
