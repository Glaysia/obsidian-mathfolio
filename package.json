{
  "name": "obsidian-mathfolio",
  "version": "0.1.8",
  "private": true,
  "description": "Mathfolio worksheet editor integration for Obsidian.",
  "type": "module",
  "main": "main.js",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Glaysia/obsidian-mathfolio.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "npm run sdk:verify && node scripts/check.mjs && node --check scripts/build.mjs && node --check scripts/sdk-link.mjs && node --check scripts/version.mjs && node --check scripts/install.mjs && node --check scripts/sdk-build.mjs && node --check scripts/sdk-prepare.mjs && node --check scripts/audit.mjs && node --check scripts/audit-policy.mjs",
    "build": "npm run check && node scripts/build.mjs",
    "check:release": "node scripts/check.mjs --release",
    "sdk:link": "node scripts/sdk-link.mjs",
    "version": "node scripts/version.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:vault": "node scripts/install.mjs",
    "sdk:build": "node scripts/sdk-build.mjs",
    "lint": "eslint . --max-warnings 0",
    "sdk:verify": "node scripts/sdk-verify.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@eslint/json": "0.14.0",
    "@types/node": "24.19.2",
    "binaryen": "132.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.6.0",
    "obsidian": "1.14.4",
    "playwright": "1.59.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@mathfolio/wasm-sdk": "https://github.com/Glaysia/mathfolio/releases/download/v0.1.2/mathfolio-wasm-sdk-0.1.2.tar.gz"
  },
  "overrides": {
    "obsidian": "$obsidian",
    "moment": "2.31.0",
    "eslint-plugin-json-schema-validator": "6.3.2",
    "minimatch@>=9 <11.0.1": "11.0.4"
  }
}
